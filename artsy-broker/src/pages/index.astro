---
import Layout from '../layouts/Layout.astro';

const title = 'ArtSy Broker | Strona w budowie';
---

<Layout title={title}>
  <!-- Navigation -->
  <nav class="glass-nav">
    <div class="logo">
      <span class="neon-text">ARTSY.BROKER</span>
    </div>
    <ul class="nav-links">
      <li><a href="#about">O Mnie</a></li>
      <li><a href="#specs">Sprzęt</a></li>
      <li><a href="#services">Usługi</a></li>
      <li><a href="#contact">Kontakt</a></li>
    </ul>
  </nav>

  <!-- Hero Section -->
  <header class="hero">
    <div class="hero-content">
      <div class="status-indicator">Prace konserwacyjne</div>
      <h1 class="glitch" data-text="STRONA W BUDOWIE">STRONA W BUDOWIE</h1>
      <p>Pracujemy nad nową odsłoną naszego serwisu internetowego, aby zapewnić<br>Państwu jak najlepsze doświadczenia. Zapraszamy do kontaktu już wkrótce.</p>
      
      <div class="contact-section">
        <h2>Skontaktuj się z nami</h2>
        
        <div class="contact-item">
          <span>E-mail:</span>
          <a href="mailto:artur@artsy.broker">artur@artsy.broker</a>
        </div>

        <div class="contact-item">
          <span>Telefon:</span>
          <a href="tel:+48722326385">+48 722 326 385</a>
        </div>
      </div>
    </div>
  </header>

</Layout>
